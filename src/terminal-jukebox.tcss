#root {
	align: center middle;
	layout: vertical;
	height: 1fr;
    background: #232e30;
}

.main-border {
	height: auto;
	border: round #B8BB26;
}

ModalScreen {
	hatch: right $primary-background;
}

/* --- Header & Footer --- */

Header {
    background: #32302F;
    color: #B8BB26;
    text-style: bold;
    dock: top;
    height: 1;
}

Footer {
    background: #32302F;
    color: #B8BB26;
}

FooterKey .footer-key--key {
    color: #B8BB26;
    text-style: bold;
}

FooterKey .footer-key--description {
    color: #E8DBB4;
}

/* ---  TOP BAR --- */

#top-box {
	dock: top;
	height: auto;
}

#main-box {
	height: 1fr;
}

#top-bar Input {
	width: 1fr;
}

#top-bar Button {
	width: auto;
	min-width: 12;
}

/* --- Buttons --- */

Button {
	background: #314048;
	color: #d9d9d9;
	border: tall #32302F;
}

/* --- Tab Navigation --- */

TabbedContent {
    background: #232e30;
}

TabPane {
    padding: 1 2;
}

Tabs {
    background: #232e30;
    dock: top;
    height: 3;
}

Tab {
    background: #161b22;
    color: #8b949e;
    padding: 0 2;
}

Tab:hover {
    background: #21262d;
    color: #c9d1d9;
}

Tab.-active {
    background: #56666f;
    color: #d9d9d9;
    text-style: bold;
}

/* --- Playlists Section --- */

#playlists {
    max-width: 20;
}

#playlists, #song-playlists {
    background: #314048;
    color: #314048;
}


.playlist-btn {
    background: #56666f;
    min-width: 20;
    margin: 0 0 1 0;
}

.title {
    color: #d9d9d9;
    margin: 1;
}

.active-playlist-btn {
    background: #232e30;
}

/* --- Bottom Bar --- */

Label {
    color: #d9d9d9;
}

#bottom-box {
	max-height: 8;
	border: round #B8BB26;
}

#song-info {
    align: left middle;
}

#music-player * {
    align: center middle;
}

#volume-control {
    align: right middle;
}

/* --- Confirm Dialog --- */

#confirm-dialog {
    background: #32302F;
    border: round #B8BB26;
    padding: 2 4;
    width: 50;
    height: auto;
    max-height: 16;
}

#confirm-dialog Static {
    color: #c9d1d9;
    margin-bottom: 1;
}

#confirm-dialog .dialog-buttons {
    layout: horizontal;
    height: auto;
    align: center middle;
}

#confirm-dialog .dialog-buttons Button {
    margin: 0 2 0 0;
}

/* --- Folder Dialog --- */

#scan-folders-widget, #folder-dialog, #delete-popup {
    background: #32302F;
    border: round #B8BB26;
    padding: 2 4;
    min-width: 35;
    max-width: 75;
    height: auto;
    max-height: 25;
}

#music-folders, #folder-tree {
    min-height: 10;
    max-height: 15;
    padding: 1 0;
}

.dialog-buttons {
    layout: horizontal;
    height: auto;
    align: center middle;
}

.dialog-buttons Button {
    margin: 0 2 0 0;
}

#file-popup-title {
    text-align: center;
}

/* --- Add To Playlist Popup --- */

#add-to-playlist-popup {
    background: #32302F;
    border: round #B8BB26;
    padding: 2 4;
    min-width: 25;
    max-width: 55;
    height: auto;
    max-height: 25;
}

#playlists-ls {
    margin: 1 0;
}

/* --- Song Submenu --- */

#options-submenu {
    background: #32302F;
    border: round #B8BB26;
    padding: 2 4;
    min-width: 35;
    max-width: 40;
    height: auto;
    max-height: 25;
}

/* --- Edit Song Info --- */

#song-editor {
    background: #32302F;
    border: round #B8BB26;
    padding: 2;
    min-width: 40;
    max-width: 60;
    height: auto;
    max-height: 30;
}

.group-song-edit Input {
    width: 1fr;
}

/* --- Loading Screen Popup --- */

LoadingScreen Vertical {
    background: #32302F;
    border: round #B8BB26;
    width: auto;
    height: auto;
    padding: 0 5;

    LoadingIndicator {
        height: 1;
    }
}